generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
  ADVANCED
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum BillingPeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TimePeriodStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

model Organization {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  logo                 String?
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  billingPeriod        BillingPeriod @default(MONTHLY)
  currency             String        @default("USD")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members     User[]
  tags        Tag[]
  clients     Client[]
  projects    Project[]
  timePeriods TimePeriod[]
  invites           Invite[]
  invoices          Invoice[]
  lastInvoiceNumber Int          @default(0)

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  avatarUrl      String?
  passwordHash   String?
  role           Role     @default(MEMBER)
  organizationId String
  weekStartDay   Int      @default(1)
  connectedQBO   Boolean  @default(false)
  qboRealmId     String?
  qboTokens      String?
  connectedXero  Boolean  @default(false)
  xeroTenantId   String?
  xeroTokens     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  sessions      Session[]
  accounts      Account[]

  @@index([organizationId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  currency       String  @default("USD")
  qboCustomerId  String?
  xeroContactId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  invoices     Invoice[]

  @@index([organizationId])
  @@map("clients")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  description    String?
  color          String   @default("#3730A3")
  icon           String?
  hourlyRate     Decimal  @default(0) @db.Decimal(10, 2)
  isBillable     Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries  TimeEntry[]

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@map("projects")
}

model TimeEntry {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  description     String?
  startedAt       DateTime
  stoppedAt       DateTime?
  durationSeconds Int?
  isBillable      Boolean   @default(true)
  timePeriodId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timePeriod TimePeriod? @relation(fields: [timePeriodId], references: [id], onDelete: SetNull)
  tags       TimeEntryTag[]

  @@index([userId])
  @@index([projectId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([timePeriodId])
  @@map("time_entries")
}

model TimePeriod {
  id             String           @id @default(cuid())
  organizationId String
  periodType     BillingPeriod    @default(MONTHLY)
  startDate      DateTime
  endDate        DateTime
  status         TimePeriodStatus @default(OPEN)
  approvedAt     DateTime?
  approvedBy     String?
  publishedAt    DateTime?
  reportPdfUrl   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      TimeEntry[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("time_periods")
}

model Tag {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      TimeEntryTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model TimeEntryTag {
  timeEntryId String
  tagId       String

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, tagId])
  @@index([tagId])
  @@map("time_entry_tags")
}

model Invite {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  role           Role     @default(MEMBER)
  token          String   @unique @default(cuid())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  periodId       String?
  clientId       String
  invoiceNumber  String
  amount         Decimal
  currency       String        @default("USD")
  status         InvoiceStatus @default(PENDING)
  qboInvoiceId   String?
  xeroInvoiceId  String?
  failureReason  String?
  issuedAt       DateTime?
  pdfUrl         String?
  pdfData        Bytes?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  period       TimePeriod?  @relation(fields: [periodId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])

  // The ledger's backbone: one invoice per client per period, enforced by the
  // database so a retry cannot double-bill. periodId is nullable and Postgres
  // treats NULLs as distinct, so ad-hoc invoices are unconstrained.
  @@unique([periodId, clientId])
  @@index([organizationId])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
}
